        "item_family": "assessment-normalization",
        "options": [
          {"id": "a", "label": "No; its squared magnitudes sum to 1/2"},
          {"id": "b", "label": "Yes; its entries sum to 1"},
          {"id": "c", "label": "Yes; its squared magnitudes sum to 1"},
          {"id": "d", "label": "No; a valid state cannot have two equal entries"}
        ]
      },
      {
        "number": 4,
