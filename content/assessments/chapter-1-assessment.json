        "goal_kind": "distribution",
        "constraints": {
          "initial_state": "ket1",
          "allowed_operations": ["x"],
          "max_operations": 3,
          "min_operations": 1
        }
      },
      {
        "number": 7,
        "id": "A7",
        "kind": "single_select",
        "prompt": "What state results from applying H to |1>?",
