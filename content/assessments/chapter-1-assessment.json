        "item_family": "assessment-sampling",
        "options": [
          {"id": "a", "label": "No; equal probabilities do not fix a finite count"},
          {"id": "b", "label": "Yes; the Born rule requires it"},
          {"id": "c", "label": "Yes, unless the run is replayed"},
          {"id": "d", "label": "No; eight zeros cannot occur"}
