# Backend image: FastAPI, the Qiskit engine, and the authored content.
# The NVIDIA key is never baked into a layer or a build argument; it is read
# from the deployment's secret settings at run time.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /usr/local/bin/uv

WORKDIR /app

# Dependencies first, so a content or code edit does not re-resolve them.
COPY backend/pyproject.toml backend/uv.lock backend/.python-version ./backend/
RUN cd backend && uv sync --frozen --no-dev --no-install-project

COPY backend ./backend
COPY content ./content
RUN cd backend && uv sync --frozen --no-dev

RUN useradd --create-home --uid 10001 appuser && chown -R appuser /app
USER appuser

ENV PATH="/opt/venv/bin:$PATH" \
    CONTENT_ROOT=/app/content

WORKDIR /app/backend
EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=5s --start-period=25s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8000/api/v1/health/ready || exit 1

# Graceful shutdown: uvicorn handles SIGTERM and drains in-flight requests.
STOPSIGNAL SIGTERM
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
