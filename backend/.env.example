# Copy to backend/.env after the application is implemented. Never commit that file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://quantum:quantum_local_only@localhost:5432/quantum
PUBLIC_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-cryptographically-random-local-secret
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
SESSION_COOKIE_NAME=qll_session
CSRF_COOKIE_NAME=qll_csrf

# authored = honest static course help; nvidia = real hosted model; fake = tests only
TUTOR_PROVIDER=authored
TUTOR_USAGE_MODE=internal_evaluation
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
TUTOR_TEMPERATURE=1.0
TUTOR_TOP_P=0.95
TUTOR_MAX_OUTPUT_TOKENS=1024
TUTOR_TIMEOUT_SECONDS=45
TUTOR_REQUESTS_PER_MINUTE=6
TUTOR_GLOBAL_CONCURRENCY=2
SIMULATION_MAX_OPERATIONS=100
SIMULATION_MAX_SHOTS=1024

# Production must use its actual HTTPS origin, secure cookies, real secrets,
# persistent database credentials, and an appropriate AI service arrangement.
